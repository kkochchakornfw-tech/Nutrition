# =============================================================
# ตัวอย่างไฟล์ env — คัดลอกเป็น .env.local แล้วแก้ค่า
#   cp .env.local.example .env.local
# ห้าม commit .env.local (มีความลับ) — .gitignore กันไว้แล้ว
# =============================================================

# -------------------------------------------------------------
# [ใช้งานอยู่] กุญแจเซ็น cookie ล็อกอิน (src/lib/auth/session.ts)
# ต้องเป็นสตริงสุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร และต่างกันในแต่ละเครื่อง/สภาพแวดล้อม
# ถ้าไม่ตั้ง ระบบจะใช้ค่า dev ที่ไม่ปลอดภัย — ห้ามปล่อยแบบนั้นบน production
# สร้างค่าได้ด้วย:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# เปลี่ยนค่านี้ = ทุกคนถูกออกจากระบบ (session เดิมใช้ไม่ได้)
# -------------------------------------------------------------
AUTH_SECRET=change-this-to-a-long-random-string

# =============================================================
# ด้านล่างนี้ "เตรียมไว้" — โค้ดยังไม่ได้อ่านค่าเหล่านี้
# จะใช้เมื่อเปลี่ยนจากข้อมูลในหน่วยความจำ/mock ไปใช้ระบบจริง
# =============================================================

# -------------------------------------------------------------
# [เตรียมไว้] ฐานข้อมูล MySQL/MariaDB (db/schema_v2.sql)
# สร้าง database ด้วย collation utf8mb4_unicode_ci
# แนะนำให้สร้าง user เฉพาะแอปนี้ อย่าใช้ root
# -------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=nutrition
# DB_USER=nutrition_app
# DB_PASSWORD=change-me

# -------------------------------------------------------------
# [เตรียมไว้] ระบบ HIS / AD ของโรงพยาบาล (รอ spec จากทีม HIS)
# mock = ใช้ข้อมูลทดสอบในโค้ด (ค่าปัจจุบัน)
# -------------------------------------------------------------
# AUTH_PROVIDER=mock
# HIS_PROVIDER=mock
# HIS_API_BASE_URL=https://his.example-hospital.local/api
# HIS_API_KEY=

# -------------------------------------------------------------
# Cookie session: ค่าเริ่มต้นเป็น Secure ใน production (ส่งได้เฉพาะ HTTPS)
# ถ้ารันบน HTTP ในวง LAN (เช่น http://172.16.x.x) ให้ตั้งเป็น false ไม่งั้น login แล้วไม่ติด
# -------------------------------------------------------------
# AUTH_COOKIE_SECURE=false
